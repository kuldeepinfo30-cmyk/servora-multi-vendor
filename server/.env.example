# ---------------------------------------------------------------------------
# Servora API — copy to .env and adjust
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5175
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5175,http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://servora:servora@localhost:5432/servora?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-000000"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-0000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Razorpay — leave blank to run the built-in mock gateway
# The key id is publishable (the browser sees it). The secret must stay here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Settings → Webhooks.
# Without it, /api/payments/webhook rejects every event.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
# The React demo has no database-backed checkout, so it creates amount-first
# orders. Leave this off in production once bookings are created through the API.
ENABLE_STOREFRONT_CHECKOUT=true

# Email (SMTP). Leave blank to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Servora <no-reply@servora.in>"

# SMS (MSG91). Leave blank to log SMS to the console.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SERVRA
MSG91_TEMPLATE_ID=

# Throttling
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Demo data
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo1234
